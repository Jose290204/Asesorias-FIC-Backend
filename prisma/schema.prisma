generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model asesorias {
  id_asesoria          Int                    @id @default(autoincrement())
  id_estudiante        Int
  id_asesor            Int
  id_materia           Int
  id_modalidad         Int
  fecha_inicio         DateTime               @db.Date
  fecha_fin            DateTime?              @db.Date
  id_razon             Int
  id_licenciatura      Int
  sesiones_tomadas     Int?
  observaciones        String?
  id_estatus_asesoria  Int?
  id_horario           Int                    @default(0)
  estatus_asesorias    estatus_asesorias?     @relation(fields: [id_estatus_asesoria], references: [id_estatus_asesoria], onDelete: NoAction, onUpdate: NoAction)
  licenciaturas        licenciaturas          @relation(fields: [id_licenciatura], references: [id_licenciatura], onDelete: NoAction, onUpdate: NoAction, map: "fk_asesorias_licenciatura")
  materias             materias               @relation(fields: [id_materia], references: [id_materia], onDelete: NoAction, onUpdate: NoAction, map: "fk_asesorias_materia")
  modalidades          modalidades            @relation(fields: [id_modalidad], references: [id_modalidad], onDelete: NoAction, onUpdate: NoAction, map: "fk_asesorias_modalidad")
  razon_asesoria       razon_asesoria         @relation(fields: [id_razon], references: [id_razon], onDelete: NoAction, onUpdate: NoAction, map: "fk_asesorias_razon")
  chats                chats[]
  evidencias_asesorias evidencias_asesorias[]
  material_adicional   material_adicional[]
}

model chats {
  id_mensaje  Int       @id @default(autoincrement())
  id_asesoria Int
  fecha_envio DateTime? @db.Timestamp(6)
  mensaje     String
  asesorias   asesorias @relation(fields: [id_asesoria], references: [id_asesoria], onDelete: NoAction, onUpdate: NoAction, map: "fk_chats_asesoria")
}

model dias_semana {
  id_dia Int     @id @default(autoincrement())
  dia    String? @db.VarChar(10)
}

model disponibilidad_horarios {
  id_disponibilidad_hor Int      @id @default(autoincrement())
  id_asesor             Int
  id_horario            Int
  horarios              horarios @relation(fields: [id_horario], references: [id_horario], onDelete: NoAction, onUpdate: NoAction, map: "fk_disponibilidad_horarios_horario")

  @@unique([id_asesor, id_horario], map: "uq_disponibilidad_horarios")
}

model disponibilidad_materias {
  id_disponibilidad_mat Int      @id @default(autoincrement())
  id_asesor             Int
  id_materia            Int
  materias              materias @relation(fields: [id_materia], references: [id_materia], onDelete: NoAction, onUpdate: NoAction, map: "fk_disponibilidad_materias_materia")

  @@unique([id_asesor, id_materia], map: "uq_disponibilidad_materias")
}

model estatus {
  id_estatus Int        @id @default(autoincrement())
  estatus    String     @db.VarChar(30)
  personas   personas[]
}

model estatus_asesorias {
  id_estatus_asesoria Int         @id @default(autoincrement())
  estatus_asesoria    String      @db.VarChar(20)
  asesorias           asesorias[]
}

model estatus_solicitud {
  id_estatus_solicitud  Int                     @id @default(autoincrement())
  estatus_solicitud     String                  @db.VarChar(30)
  solicitudes_asesorias solicitudes_asesorias[]
}

model evidencias_asesorias {
  id_evidencia   Int       @id @default(autoincrement())
  id_asesoria    Int
  nombre_archivo String    @unique @db.VarChar(100)
  ruta_archivo   String    @unique
  mime_type      String?   @db.VarChar(100)
  tama_o_archivo Int?      @map("tamaño_archivo")
  fecha_subida   DateTime? @db.Timestamp(6)
  asesorias      asesorias @relation(fields: [id_asesoria], references: [id_asesoria], onDelete: NoAction, onUpdate: NoAction, map: "fk_evidencias_asesoria")
}

model grupos {
  id_grupo        Int           @id @default(autoincrement())
  id_licenciatura Int
  grupo           String?       @db.VarChar(3)
  licenciaturas   licenciaturas @relation(fields: [id_licenciatura], references: [id_licenciatura], onDelete: NoAction, onUpdate: NoAction, map: "fk_grupos_licenciatura")
  personas        personas[]
}

model horarios {
  id_horario              Int                       @id @default(autoincrement())
  horario                 String                    @db.VarChar(15)
  disponibilidad_horarios disponibilidad_horarios[]
  solicitudes_asesorias   solicitudes_asesorias[]
}

model licenciaturas {
  id_licenciatura Int         @id @default(autoincrement())
  licenciatura    String      @db.VarChar(50)
  asesorias       asesorias[]
  grupos          grupos[]
  materias        materias[]
  personas        personas[]
}

model material_adicional {
  id_material    Int        @id @default(autoincrement())
  id_asesoria    Int?
  nombre_archivo String     @unique @db.VarChar(100)
  ruta_archivo   String     @unique
  mime_type      String?    @db.VarChar(100)
  tama_o_archivo Int?       @map("tamaño_archivo")
  fecha_subida   DateTime?  @db.Timestamp(6)
  asesorias      asesorias? @relation(fields: [id_asesoria], references: [id_asesoria], onDelete: NoAction, onUpdate: NoAction, map: "fk_material_asesoria")
}

model materias {
  id_materia              Int                       @id @default(autoincrement())
  materia                 String                    @db.VarChar(30)
  id_semestre             Int
  id_licenciatura         Int?
  asesorias               asesorias[]
  disponibilidad_materias disponibilidad_materias[]
  semestres               semestres                 @relation(fields: [id_semestre], references: [id_semestre], onDelete: NoAction, onUpdate: NoAction, map: "fk_materias_semestre")
  licenciaturas           licenciaturas?            @relation(fields: [id_licenciatura], references: [id_licenciatura], onDelete: NoAction, onUpdate: NoAction)
  solicitudes_asesorias   solicitudes_asesorias[]
}

model modalidades {
  id_modalidad          Int                     @id @default(autoincrement())
  modalidad             String                  @db.VarChar(20)
  asesorias             asesorias[]
  solicitudes_asesorias solicitudes_asesorias[]
}

model personas {
  id_persona       Int            @id @default(autoincrement())
  nombre           String         @db.VarChar(30)
  apellido_paterno String         @db.VarChar(20)
  apellido_materno String         @db.VarChar(20)
  correo           String         @unique @db.VarChar(50)
  num_cel          String         @unique @db.VarChar(15)
  id_licenciatura  Int?
  promedio         Decimal?       @db.Decimal(4, 2)
  id_grupo         Int?
  id_estatus       Int            @db.SmallInt
  estatus          estatus        @relation(fields: [id_estatus], references: [id_estatus], onDelete: NoAction, onUpdate: NoAction, map: "fk_personas_estatus")
  grupos           grupos?        @relation(fields: [id_grupo], references: [id_grupo], onDelete: NoAction, onUpdate: NoAction, map: "fk_personas_grupo")
  licenciaturas    licenciaturas? @relation(fields: [id_licenciatura], references: [id_licenciatura], onDelete: NoAction, onUpdate: NoAction, map: "fk_personas_licenciatura")

}

model razon_asesoria {
  id_razon              Int                     @id @default(autoincrement())
  razon                 String                  @db.VarChar(15)
  asesorias             asesorias[]
  solicitudes_asesorias solicitudes_asesorias[]
}

model roles {
  id_rol   Int        @id @default(autoincrement())
  rol      String?    @db.VarChar(30)
  usuarios usuarios[]
}

model semestres {
  id_semestre Int        @id @default(autoincrement())
  semestre    String?    @db.VarChar(13)
  materias    materias[]
}

model solicitudes_asesorias {
  id_solicitud       Int               @id @default(autoincrement())
  id_materia         Int
  id_horario         Int
  id_modalidad       Int
  id_estudiante      Int
  id_asesor          Int
  fecha_inicio       DateTime          @db.Date
  id_razon           Int
  nota_estudiante    String?
  explicacion_asesor String?
  id_estatus         Int
  estatus_solicitud  estatus_solicitud @relation(fields: [id_estatus], references: [id_estatus_solicitud], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitudes_estatus")
  horarios           horarios          @relation(fields: [id_horario], references: [id_horario], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitudes_horario")
  materias           materias          @relation(fields: [id_materia], references: [id_materia], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitudes_materia")
  modalidades        modalidades       @relation(fields: [id_modalidad], references: [id_modalidad], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitudes_modalidad")
  razon_asesoria     razon_asesoria    @relation(fields: [id_razon], references: [id_razon], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitudes_razon")
}

model usuarios {
  id_persona Int    @id
  usuario    Int    @unique
  contrasena String @db.VarChar(255)
  id_rol     Int
  roles      roles  @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuarios_rol")
  personas   personas @relation(fields: [id_persona], references: [id_persona])
}
