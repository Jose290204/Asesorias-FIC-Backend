generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model asesorias {
  id_asesoria          Int                    @id @default(autoincrement())
  id_estudiante        Int
  id_asesor            Int
  id_materia           Int
  id_modalidad         Int
  fecha_inicio         DateTime               @db.Date
  fecha_fin            DateTime?              @db.Date
  id_razon             Int
  id_licenciatura      Int
  sesiones_tomadas     Int?
  observaciones        String?                @db.Text
  id_estatus_asesoria  Int?
  id_horario           Int?                   @default(0)
  estatus_asesorias    estatus_asesorias?     @relation(fields: [id_estatus_asesoria], references: [id_estatus_asesoria], onDelete: NoAction, onUpdate: NoAction)
  licenciaturas        licenciaturas          @relation(fields: [id_licenciatura], references: [id_licenciatura], onDelete: NoAction, onUpdate: NoAction)
  materias             materias               @relation(fields: [id_materia], references: [id_materia], onDelete: NoAction, onUpdate: NoAction)
  modalidades          modalidades            @relation(fields: [id_modalidad], references: [id_modalidad], onDelete: NoAction, onUpdate: NoAction)
  razon_asesoria        razon_asesoria         @relation(fields: [id_razon], references: [id_razon], onDelete: NoAction, onUpdate: NoAction)
  chats                chats[]
  evidencias_asesorias evidencias_asesorias[]
  material_adicional   material_adicional[]

  @@index([id_estatus_asesoria])
  @@index([id_licenciatura])
  @@index([id_materia])
  @@index([id_modalidad])
  @@index([id_razon])
}

model chats {
  id_mensaje  Int       @id @default(autoincrement())
  id_asesoria Int
  fecha_envio DateTime?
  mensaje     String    @db.Text
  asesorias   asesorias @relation(fields: [id_asesoria], references: [id_asesoria], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_asesoria])
}

model dias_semana {
  id_dia Int     @id @default(autoincrement())
  dia    String? @db.VarChar(10)
}

model disponibilidad_horarios {
  id_disponibilidad_hor Int      @id @default(autoincrement())
  id_asesor             Int
  id_horario            Int
  horarios              horarios @relation(fields: [id_horario], references: [id_horario], onDelete: NoAction, onUpdate: NoAction)
  asesor                personas @relation(fields: [id_asesor], references: [id_persona], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_asesor, id_horario], map: "uq_disponibilidad_horarios")
  @@index([id_horario])
  @@index([id_asesor])
}

model disponibilidad_materias {
  id_disponibilidad_mat Int      @id @default(autoincrement())
  id_asesor             Int
  id_materia            Int
  materias              materias @relation(fields: [id_materia], references: [id_materia], onDelete: NoAction, onUpdate: NoAction)
  asesor                personas @relation(fields: [id_asesor], references: [id_persona], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_asesor, id_materia], map: "uq_disponibilidad_materias")
  @@index([id_materia])
  @@index([id_asesor])
}

model estatus {
  id_estatus Int        @id @default(autoincrement())
  estatus    String     @db.VarChar(30)
  personas   personas[]
}

model estatus_asesorias {
  id_estatus_asesoria Int         @id @default(autoincrement())
  estatus_asesoria    String      @db.VarChar(20)
  asesorias           asesorias[]
}

model estatus_solicitud {
  id_estatus_solicitud  Int                     @id @default(autoincrement())
  estatus_solicitud     String                  @db.VarChar(30)
  solicitudes_asesorias solicitudes_asesorias[]
}

model evidencias_asesorias {
  id_evidencia   Int       @id @default(autoincrement())
  id_asesoria    Int
  nombre_archivo String    @db.VarChar(255)
  drive_file_id  String    @db.VarChar(255)
  url_archivo    String    @db.Text
  mime_type      String?   @db.VarChar(100)
  tamano_archivo Int?
  fecha_subida   DateTime? @default(now())
  asesorias      asesorias @relation(fields: [id_asesoria], references: [id_asesoria], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_asesoria])
}

model grupos {
  id_grupo        Int           @id @default(autoincrement())
  id_licenciatura Int
  grupo           String?       @db.VarChar(3)
  licenciaturas   licenciaturas @relation(fields: [id_licenciatura], references: [id_licenciatura], onDelete: NoAction, onUpdate: NoAction)
  personas        personas[]

  @@index([id_licenciatura])
}

model horarios {
  id_horario              Int                       @id @default(autoincrement())
  horario                 String                    @db.VarChar(15)
  disponibilidad_horarios disponibilidad_horarios[]
  solicitudes_asesorias   solicitudes_asesorias[]
}

model licenciaturas {
  id_licenciatura Int         @id @default(autoincrement())
  licenciatura    String      @db.VarChar(80)
  asesorias       asesorias[]
  grupos          grupos[]
  materias        materias[]
  personas        personas[]
}

model material_adicional {
  id_material    Int        @id @default(autoincrement())
  id_asesoria    Int?
  nombre_archivo String     @db.VarChar(255)
  drive_file_id  String     @db.VarChar(255)
  url_archivo    String     @db.Text
  mime_type      String?    @db.VarChar(100)
  tamano_archivo Int?
  fecha_subida   DateTime?  @default(now())
  asesorias      asesorias? @relation(fields: [id_asesoria], references: [id_asesoria], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_asesoria])
}

model materias {
  id_materia              Int                       @id @default(autoincrement())
  materia                 String                    @db.VarChar(80)
  id_semestre             Int
  id_licenciatura         Int
  id_plan                 Int
  asesorias               asesorias[]
  disponibilidad_materias disponibilidad_materias[]
  licenciaturas           licenciaturas             @relation(fields: [id_licenciatura], references: [id_licenciatura], onDelete: NoAction, onUpdate: NoAction)
  plan_estudios           plan_estudios             @relation(fields: [id_plan], references: [id_plan], onDelete: NoAction, onUpdate: NoAction)
  semestres               semestres                 @relation(fields: [id_semestre], references: [id_semestre], onDelete: NoAction, onUpdate: NoAction)
  solicitudes_asesorias   solicitudes_asesorias[]

  @@index([id_licenciatura])
  @@index([id_plan])
  @@index([id_semestre])
}

model modalidades {
  id_modalidad          Int                     @id @default(autoincrement())
  modalidad             String                  @db.VarChar(20)
  asesorias             asesorias[]
  solicitudes_asesorias solicitudes_asesorias[]
}

model personas {
  id_persona       Int            @id @default(autoincrement())
  nombre           String         @db.VarChar(30)
  apellido_paterno String         @db.VarChar(20)
  apellido_materno String         @db.VarChar(20)
  numero_cuenta    Int?           @unique
  correo           String         @unique @db.VarChar(50)
  num_cel          String?        @unique @db.VarChar(15)
  id_licenciatura  Int?
  promedio         Decimal?       @db.Decimal(4, 2)
  id_grupo         Int?
  id_estatus       Int            @default(1)
  estatus          estatus        @relation(fields: [id_estatus], references: [id_estatus], onDelete: NoAction, onUpdate: NoAction)
  grupos           grupos?        @relation(fields: [id_grupo], references: [id_grupo], onDelete: NoAction, onUpdate: NoAction)
  licenciaturas    licenciaturas? @relation(fields: [id_licenciatura], references: [id_licenciatura], onDelete: NoAction, onUpdate: NoAction)

  usuario_rel             usuarios?                 @relation(fields: [id_persona], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  disponibilidad_materias disponibilidad_materias[]
  disponibilidad_horarios disponibilidad_horarios[]

  @@index([id_estatus])
  @@index([id_grupo])
  @@index([id_licenciatura])
}

model razon_asesoria {
  id_razon              Int                     @id @default(autoincrement())
  razon                 String                  @db.VarChar(15)
  asesorias             asesorias[]
  solicitudes_asesorias solicitudes_asesorias[]
}

model roles {
  id_rol   Int        @id @default(autoincrement())
  rol      String     @db.VarChar(30)
  usuarios usuarios[]
}

model semestres {
  id_semestre Int        @id @default(autoincrement())
  semestre    String?    @db.VarChar(13)
  materias    materias[]
}

model solicitudes_asesorias {
  id_solicitud       Int               @id @default(autoincrement())
  id_materia         Int
  id_horario         Int
  id_modalidad       Int
  id_estudiante      Int
  id_asesor          Int
  fecha_inicio       DateTime          @db.Date
  id_razon           Int
  nota_estudiante    String?           @db.Text
  explicacion_asesor String?           @db.Text
  id_estatus         Int
  estatus_solicitud  estatus_solicitud @relation(fields: [id_estatus], references: [id_estatus_solicitud], onDelete: NoAction, onUpdate: NoAction)
  horarios           horarios          @relation(fields: [id_horario], references: [id_horario], onDelete: NoAction, onUpdate: NoAction)
  materias           materias          @relation(fields: [id_materia], references: [id_materia], onDelete: NoAction, onUpdate: NoAction)
  modalidades        modalidades       @relation(fields: [id_modalidad], references: [id_modalidad], onDelete: NoAction, onUpdate: NoAction)
  razon_asesoria     razon_asesoria    @relation(fields: [id_razon], references: [id_razon], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_estatus])
  @@index([id_horario])
  @@index([id_materia])
  @@index([id_modalidad])
  @@index([id_razon])
}

model plan_estudios {
  id_plan       Int        @id @default(autoincrement())
  plan_estudios String     @db.VarChar(4)
  materias      materias[]
}

model usuarios {
  id_usuario     Int       @id @default(autoincrement())
  usuario        String    @unique @db.VarChar(30)
  password_hash  String    @db.VarChar(255)
  id_rol         Int
  activo         Boolean?  @default(true)
  fecha_creacion DateTime? @default(now())
  roles          roles     @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)

  datos_persona personas?

  @@index([id_rol])
}